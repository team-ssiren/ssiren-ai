filters:
  and:
    - note["base"] == link("API 명세서.base")
properties:
  file.name:
    displayName: 기능
  도메인:
    displayName: 도메인
  권한:
    displayName: 권한
  프론트 담당자:
    displayName: 프론트 담당자
  HTTP 메서드:
    displayName: HTTP 메서드
  담당자:
    displayName: 담당자
  토큰:
    displayName: 토큰
  프론트 개발 현황:
    displayName: 프론트 개발 현황
  디자인:
    displayName: 디자인
  API Path:
    displayName: API Path
  백엔드 개발 현황:
    displayName: 백엔드 개발 현황
views:
  - type: table
    name: Table View
    order:
      - file.name
      - 도메인
      - 권한
      - 프론트 담당자
      - HTTP 메서드
      - 담당자
      - 토큰
      - 프론트 개발 현황
      - 디자인
      - API Path
      - 백엔드 개발 현황
