# --- OpenAI (required) ---
# API base URL override (비우면 기본 OpenAI 엔드포인트)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-your-key-here

# 1차(대분류)·2차(소분류) 분류 모델.
CLASSIFY_MODEL=gpt-5.4-mini

# 3차(enrich) 모델. 품질이 중요하면 gpt-5.5(지연 ~3배)
OPENAI_MODEL=gpt-5.4-mini

LLM_SEND_TEMPERATURE=false
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=60

# SDK 전송 재시도(network/5xx/429).
LLM_MAX_RETRIES=1

# 구조화 출력이 스키마/JSON 검증에 실패할 때 앱 레벨 재시도 횟수.
STRUCTURED_OUTPUT_MAX_RETRIES=2
LLM_MAX_CONCURRENCY=8


# --- Embeddings (OpenAI text-embedding-3-small) ---
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_MAX_CONCURRENCY=8


# --- Analyze (image guards) ---
ANALYZE_MAX_IMAGES=5
ANALYZE_MAX_IMAGE_MB=50
ANALYZE_MAX_IMAGE_PIXELS=1000000


# --- App ---
ENVIRONMENT=local


# --- Chatbot ---
CHATBOT_HISTORY_MAX_TURNS=10
CHATBOT_TITLE_MAX_CHARS=10


# --- Data.go.kr ---
DATA_GOKR_API_KEY=your-data-gokr-api-key-here


# --- SQLite (AI-only: assignment guide + org directory) ---
SQLITE_DB_PATH=data/ssiren.db
ORG_DEFAULT_REGION_CODE=BUNDANG