# --- OpenAI (required) ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-5.5
# GPT-5 family only supports the default temperature; keep send off for those models.
LLM_SEND_TEMPERATURE=false
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1
LLM_MAX_CONCURRENCY=8

# --- Embeddings (OpenAI text-embedding-3-small) ---
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_MAX_CONCURRENCY=8

# --- Analyze (image guards) ---
ANALYZE_MAX_IMAGES=5
ANALYZE_MAX_IMAGE_MB=50
ANALYZE_MAX_IMAGE_PIXELS=1000000

# --- App ---
ENVIRONMENT=local

# --- Chatbot ---
CHATBOT_HISTORY_MAX_TURNS=10
CHATBOT_TITLE_MAX_CHARS=10
